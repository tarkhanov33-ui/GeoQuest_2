<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/mainbackground"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:alpha="0.4"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="60dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/menu_login"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="@color/bg_dark"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/gold_accent"/>

        <LinearLayout
            android:id="@+id/orLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="3dp"
            android:layout_marginVertical="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/gold_accent_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="Or"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent_variant" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/gold_accent_variant" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/menu_signup"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gold_accent"
            app:cornerRadius="24dp"
            app:strokeColor="@color/gold_accent"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/surface_dark" />

    </LinearLayout>

</RelativeLayout>
